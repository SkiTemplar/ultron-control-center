{
  "version": "1.0",
  "updated": "2026-04-27",
  "_comment": "MCP catalog for ultron mcp install/uninstall/validate. Each entry describes how to install a public MCP server. Edit freely - this file is user-owned. Add new entries as MCPs are released.",
  "mcps": [
    {
      "id": "supabase",
      "name": "Supabase",
      "category": "database",
      "description": "Database, auth, storage, edge functions for Supabase projects",
      "docs_url": "https://github.com/supabase-community/supabase-mcp",
      "transport": "stdio",
      "multi_account": true,
      "package": {"type": "npm", "name": "@supabase/mcp-server-supabase"},
      "settings_template": {
        "command": "npx",
        "args": ["-y", "@supabase/mcp-server-supabase@latest"],
        "env": {"SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"},
        "type": "stdio"
      },
      "prompts": [
        {"key": "SUPABASE_ACCESS_TOKEN", "label": "Personal Access Token (sbp_...)", "secret": true,
         "url_hint": "https://supabase.com/dashboard/account/tokens"},
        {"key": "_read_only", "label": "Read-only mode (recommended)? (y/N)", "secret": false,
         "applies_to": "args", "if_yes": "--read-only", "default": "n"},
        {"key": "_project_ref", "label": "Pin to single project ref (optional, leave blank for all)", "secret": false,
         "applies_to": "args", "format": "--project-ref={value}"}
      ]
    },
    {
      "id": "github",

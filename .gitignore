# ULTRON ~/.ultron/ — operational state + tooling
# Initialized 2026-05-10 as part of v14.9 STRUCTURE prep

# Python venv (regenerable via `uv sync`)
.venv/

# Ephemeral session state
.tmp/
sessions/
multimodel/
quarantine/
skill_cache/

# Brain index (rebuildable)
brain_index/*.db
brain_index/*.db-journal
brain_index/*.db-wal
brain_index/*.db-shm

# Backups (must NOT enter git history; could leak secrets/snapshots)
backups/

# Logs
logs/
*.log

# Bytecode
__pycache__/
*.pyc
*.pyo

# Qdrant residual (real data is in D:\Qdrant\data via bind mount)
qdrant_storage/

# OS / editor noise
*.swp
*.bak
.DS_Store
Thumbs.db

# Lockfiles for things that shouldn't be tracked
*.lock
!uv.lock

# Audit logs that may include paths/IDs from runs
audits/*.log

# Telemetry runtime data
telemetry/*.jsonl
telemetry/*.db

# Bus runtime data (v15.1) — sessions, mailboxes, dedup ring; never tracked
bus/

# Skill vault (v15.0b) — skill dirs live on disk, not in git; only INDEX + keep-list tracked
skill-vault/*
!skill-vault/INDEX.json
!skill-vault/keep-list.txt

# Skills unified registry (v15.0b WS6) — generado por `skill_vault.py registry`, regenerable
skills/registry.json

# v15.0.2: qdrant native binary + logs (downloadable, not vendored in git)
qdrant-native/qdrant.exe
qdrant-native/config/config
qdrant-native/config/development
qdrant_storage/

# v15.0.3: rotated alerts archive (rebuildable, 1.3MB+)
alerts.jsonl.archive

# v15.2 PUBLIC RELEASE — personal data must NEVER enter public history
# User-specific content
personal/
cockpit/news/*.html
cockpit/news/*.md
cockpit/news/cache/

# Runtime state that contains user paths or IDs (regenerated per-install)
cockpit/projects.json
cockpit/bridge-index.json
cockpit/features.json
cockpit/apps.json
cockpit/mcp-audit.jsonl
cockpit/auto_updater.jsonl
manifest.cache.json
agent_manifest.json
background_tasks.json
alerts.jsonl
plans/PLANS.json

# Historical telemetry (may leak personal context)
archive/
telemetry/

# Tauri build output
control-center/dist/
control-center/src-tauri/target/
control-center/node_modules/

# Playwright / temp upload scratch
.playwright-mcp/
.tmp.driveupload/

# Cover images (not part of release artifacts)
cover*.png
v*-cover*.png
v*-s*.png
v*-demo*.png
v*-waiting*.png
v*-layerstack.png


# ULTRON ~/.ultron/ — operational state + tooling
# Initialized 2026-05-10 as part of v14.9 STRUCTURE prep

# Python venv (regenerable via `uv sync`)
.venv/

# Ephemeral session state
.tmp/
sessions/
multimodel/
quarantine/
skill_cache/

# Brain index (rebuildable)
brain_index/*.db
brain_index/*.db-journal
brain_index/*.db-wal
brain_index/*.db-shm

# Backups (must NOT enter git history; could leak secrets/snapshots)
backups/

# Logs
logs/
*.log

# Bytecode
__pycache__/
*.pyc
*.pyo

# Qdrant residual (real data is in D:\Qdrant\data via bind mount)
qdrant_storage/

# OS / editor noise
*.swp
*.bak
.DS_Store
Thumbs.db

# Lockfiles for things that shouldn't be tracked
*.lock
!uv.lock

# Audit logs that may include paths/IDs from runs
audits/*.log

# Telemetry runtime data
telemetry/*.jsonl
telemetry/*.db

# Bus runtime data (v15.1) — sessions, mailboxes, dedup ring; never tracked
bus/

# Skill vault (v15.0b) — skill dirs live on disk, not in git; only INDEX + keep-list tracked
skill-vault/*
!skill-vault/INDEX.json
!skill-vault/keep-list.txt

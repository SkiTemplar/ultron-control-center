# ULTRON ~/.ultron/ — operational state + tooling
# Public release v15.2 — personal data must NEVER enter public history
# Initialized 2026-05-10 (v14.9 STRUCTURE), hardened 2026-05-16 (v15.2 pre-publish)

# === Python / build ===
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.uv-cache-rescue/

# === Ephemeral session state ===
.tmp/
.tmp.driveupload/
sessions/
multimodel/
quarantine/
skill_cache/

# === Brain index (rebuildable) ===
brain_index/*.db
brain_index/*.db-journal
brain_index/*.db-wal
brain_index/*.db-shm

# === Backups (may leak secrets/snapshots) ===
backups/

# === Logs ===
logs/
*.log

# === OS / editor noise ===
*.swp
*.bak
.DS_Store
Thumbs.db

# === Lockfiles ===
*.lock
!uv.lock

# === Audit / telemetry / metrics (user-specific) ===
audits/
telemetry/
metrics/
integrity/settings.snapshots.jsonl

# === Bus runtime data ===
bus/

# === Skill vault (only INDEX + keep-list tracked) ===
skill-vault/*
!skill-vault/INDEX.json
!skill-vault/keep-list.txt
skills/registry.json

# === Qdrant ===
qdrant-native/qdrant.exe
qdrant-native/.qdrant-initialized
qdrant-native/config/config
qdrant-native/config/development
qdrant-native/config/production.yaml
qdrant_storage/

# === Personal data (NEVER commit) ===
personal/
personal/**
MEMORY.md
SYSTEM-MAP.md
alerts.jsonl
alerts.jsonl.archive
alerts.jsonl.lock
inbox.jsonl
background_tasks.json
agent_manifest.json
manifest.cache.json

# === Cockpit runtime (user-specific) ===
cockpit/projects.json
cockpit/projects-exclusions.json
cockpit/bridge-index.json
cockpit/features.json
cockpit/features.example.json
cockpit/apps.json
cockpit/mcp-audit.jsonl
cockpit/auto_updater.jsonl
cockpit/pending_actions.json
cockpit/news/
cockpit/audits/
plans/PLANS.json
plans/_archive/

# === Historical context (may leak personal info) ===
archive/

# === Tauri build output ===
control-center/dist/
control-center/src-tauri/target/
control-center/node_modules/
node_modules/
dist/
target/

# === Playwright cache ===
.playwright-mcp/

# === Legacy ===
_legacy/

# === Cover images (not part of release artifacts) ===
cover*.png
v*-cover*.png
v*-s*.png
v*-demo*.png
v*-waiting*.png
v*-layerstack.png

{
  "_comment": "ULTRON hook template. Merged into ~/.claude/settings.json by install.ps1 / install.sh. The token {USERPROFILE} is expanded to the user's home (forward-slash form) at install time. These commands mirror the live, working hook wiring: Node hooks live in hooks/scripts/*.js, the routing dispatcher in cockpit/skill-lazy/, and the two surviving Python hooks (deny-secrets.py, route_quality_aggregator.py) run via `uv run python`. Keep this file in sync with the live settings.json — every referenced script MUST exist in the repo.",
  "_schema_version": 3,

  "permissions": {
    "_comment": "Defense-in-depth deny list. Hooks run AFTER this filter, so this is the cheapest layer to block obvious foot-guns.",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(*>.env*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Read(**/.env*)",
      "Read(**/credentials*)",
      "Read(**/*-secret*)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/ensure-qdrant.js", "timeout": 10 },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/memory-warmup.js", "timeout": 5 },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/load-cross-project-memory.js", "timeout": 8 },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/session-start-override.js", "timeout": 5 },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/memory-session-resume.js", "timeout": 12 }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/cockpit/skill-lazy/routing-dispatcher.v2.js", "timeout": 5 },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/save-user-prompt.js", "timeout": 5 },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/memory-orchestrate.js", "timeout": 12 }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "uv run python {USERPROFILE}/.ultron/scripts/hooks/deny-secrets.py", "timeout": 5 }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/codegraph-reminder.js", "timeout": 5 }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/posttoolfail-capture.js", "timeout": 15, "async": true }
        ]
      }
    ],

    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/precompact-preserve-l0.js", "timeout": 15 }
        ]
      }
    ],

    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/subagent-harvest.js", "timeout": 20, "async": true }
        ]
      }
    ],

    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/session-end-summary.js", "timeout": 20, "async": true }
        ]
      }
    ],

    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/notify-relay.js", "timeout": 15, "async": true }
        ]
      }
    ],

    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/stop-compress-session.js", "timeout": 30, "async": true },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/kanban-update-reminder.js", "timeout": 5, "async": true },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/batch-capture.js", "timeout": 10, "async": true },
          { "type": "command", "command": "node {USERPROFILE}/.ultron/hooks/scripts/qdrant-mirror-sync.js", "timeout": 30, "async": true },
          { "type": "command", "command": "uv run python {USERPROFILE}/.ultron/scripts/cockpit/route_quality_aggregator.py aggregate --today", "timeout": 20, "async": true }
        ]
      }
    ]
  }
}

{
  "_comment": "ULTRON hook template, GENERADA por hooks/regen-manifest.js desde ~/.claude/settings.json (no editar a mano). install.ps1 / install.sh la fusionan en ~/.claude/settings.json y expanden {USERPROFILE} al home del usuario (barras /). Gate de paridad: node hooks/regen-manifest.js --check.",
  "_schema_version": 4,
  "permissions": {
    "_comment": "Defense-in-depth deny list. Hooks run AFTER this filter, so this is the cheapest layer to block obvious foot-guns.",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(*>.env*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Read(**/.env*)",
      "Read(**/credentials*)",
      "Read(**/*-secret*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/notify-relay.js",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/pupus-permission.js",
            "timeout": 660
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/model-family-guard.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/posttoolfail-capture.js",
            "timeout": 15,
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/guardrails-post.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/run-project-tests.js",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/posttoolfail-capture.js",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/precompact-preserve-l0.js",
            "timeout": 15
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/model-family-guard.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Bash|PowerShell|Monitor|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/deny-secrets.js",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/document-convert-hint.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Read|mcp__codegraph__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/codegraph-first.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/guardrails-pre.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/uni-deliverable-guard.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/session-end-bitacora.js",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/lesson-distill.js",
            "timeout": 60,
            "async": true
          },
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/project-profile.js",
            "timeout": 75,
            "async": true
          },
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/session-feedback-mark.js",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/memory-gc.js",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/ensure-codegraph.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/memory-session-resume.js",
            "timeout": 12
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/ensure-project.js",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/sessions-rich-format.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/stop-compress-session.js",
            "timeout": 60,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/batch-capture.js",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/subagent-lifecycle.js",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/subagent-harvest.js",
            "timeout": 20,
            "async": true
          },
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/subagent-lifecycle.js",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/socratic-gate.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/save-user-prompt.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/memory-orchestrate.js",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/session-feedback-capture.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/run-project-tests-report.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/context-guard.js",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node {USERPROFILE}/.ultron/hooks/scripts/usage-pace-guard.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

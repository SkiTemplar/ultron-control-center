{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the ULTRON Control Center main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "opener:default",
    "notification:default",
    "notification:allow-notify",
    "dialog:default",
    "dialog:allow-open",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "global-shortcut:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ultron-status",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\ultron\\.ps1$" },
            "status"
          ]
        },
        {
          "name": "ultron-open",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\ultron\\.ps1$" },
            "open",
            { "validator": "^[a-zA-Z0-9._\\-]{1,60}$" }
          ]
        },
        {
          "name": "ultron-scan",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\ultron\\.ps1$" },
            "scan"
          ]
        },
        {
          "name": "system-tasks-list",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\system_tasks\\.ps1$" },
            "-Action",
            "list"
          ]
        },
        {
          "name": "system-tasks-info",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\system_tasks\\.ps1$" },
            "-Action",
            "info"
          ]
        },
        {
          "name": "system-tasks-richinfo",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\system_tasks\\.ps1$" },
            "-Action",
            "richinfo"
          ]
        },
        {
          "name": "system-tasks-detail",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\system_tasks\\.ps1$" },
            "-Action",
            "detail",
            "-Name",
            { "validator": "^(ULTRON|Ultron)[A-Za-z0-9._\\-]{1,80}$" }
          ]
        },
        {
          "name": "gaming-enum",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            { "validator": "^[\\s\\S]{1,4000}$" }
          ]
        },
        {
          "name": "gaming-kill",
          "cmd": "taskkill.exe",
          "args": [
            "/F",
            { "validator": "^/PID$" },
            { "validator": "^[0-9]{1,9}$" }
          ]
        },
        {
          "name": "system-tasks-run",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\system_tasks\\.ps1$" },
            "-Action",
            "run",
            "-Name",
            { "validator": "^(ULTRON|Ultron)[A-Za-z0-9._\\-]{1,80}$" }
          ]
        },
        {
          "name": "mcp-health",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\mcp_health_check\\.py$" },
            "--quiet"
          ]
        },
        {
          "name": "brain-query",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\brain_index\\.py$" },
            "query",
            { "validator": "^[\\s\\S]{1,500}$" },
            "--limit",
            { "validator": "^[0-9]{1,3}$" }
          ]
        },
        {
          "name": "memory-vault-sync",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\memory_sync\\.py$" },
            "sync"
          ]
        },
        {
          "name": "memory-brain-update",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\brain_index\\.py$" },
            "update"
          ]
        },
        {
          "name": "memory-qdrant-reembed",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\embed_vault\\.py$" },
            "index"
          ]
        },
        {
          "name": "memory-skills-reembed",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\embed_skills\\.py$" }
          ]
        },
        {
          "name": "wt-spawn",
          "cmd": "cmd.exe",
          "args": [
            "/C",
            "wt.exe",
            "new-tab",
            "--title",
            { "validator": "^ULTRON · (claude|gemini|codex)$" },
            "--",
            "powershell.exe",
            "-NoExit",
            "-NoProfile",
            "-Command",
            { "validator": "^(Set-Location -LiteralPath '[^\\r\\n]{0,500}'; )?(claude|gemini|codex)( --dangerously-skip-permissions)?( -c)?( --fork-session)?( --model [a-zA-Z0-9._\\-]{1,80})?( --effort (low|medium|high|xhigh|max))?( -n '[^\\r\\n']{1,60}')?( -r [a-f0-9\\-]{1,80})?( -p)?( '[\\s\\S]{0,8000}')?$" }
          ]
        },
        {
          "name": "gemini-inline",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\gemini_cli\\.py$" },
            "--model",
            { "validator": "^[a-zA-Z0-9.\\-]+$" },
            { "validator": "^[\\s\\S]+$" }
          ]
        },
        {
          "name": "claude-inline-cmd",
          "cmd": "cmd.exe",
          "args": [
            "/C",
            { "validator": "^claude -p \"[\\s\\S]{1,8000}\"( --model [a-zA-Z0-9.\\-]+)?$" }
          ]
        },
        {
          "name": "codex-inline-cmd",
          "cmd": "cmd.exe",
          "args": [
            "/C",
            { "validator": "^codex exec (-m [a-zA-Z0-9.\\-]+ )?\"[\\s\\S]{1,8000}\"$" }
          ]
        },
        {
          "name": "auth-status-claude",
          "cmd": "cmd.exe",
          "args": [
            "/C",
            "claude --version"
          ]
        },
        {
          "name": "auth-status-codex",
          "cmd": "cmd.exe",
          "args": [
            "/C",
            "codex --version"
          ]
        },
        {
          "name": "auth-status-gemini",
          "cmd": "cmd.exe",
          "args": [
            "/C",
            "gemini --version"
          ]
        },
        {
          "name": "doctor-check",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\doctor_check\\.py$" }
          ]
        },
        {
          "name": "codex-adversarial",
          "cmd": "cmd.exe",
          "args": [
            "/C",
            { "validator": "^codex exec \"[\\s\\S]{1,8000}\"$" }
          ]
        }
      ]
    }
  ]
}

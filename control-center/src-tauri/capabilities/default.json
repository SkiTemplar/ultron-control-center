{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the ULTRON Control Center main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/.ultron-vault/**" },
        { "path": "$HOME/.ultron/**" },
        { "path": "$HOME/.claude/**" }
      ]
    },
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "$HOME/.ultron-vault/**" },
        { "path": "$HOME/.ultron/**" },
        { "path": "$HOME/.claude/**" }
      ]
    },
    "notification:default",
    "notification:allow-notify",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "dialog:allow-message",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "global-shortcut:default",
    "process:default",
    "process:allow-restart",
    "process:allow-exit",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ultron-status",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]ultron\\.ps1$" },
            "status"
          ]
        },
        {
          "name": "ultron-open",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]ultron\\.ps1$" },
            "open",
            { "validator": "^[a-zA-Z0-9._\\-]{1,60}$" }
          ]
        },
        {
          "name": "ultron-scan",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]ultron\\.ps1$" },
            "scan"
          ]
        },
        {
          "name": "system-tasks-list",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_tasks\\.ps1$" },
            "-Action",
            "list"
          ]
        },
        {
          "name": "system-tasks-info",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_tasks\\.ps1$" },
            "-Action",
            "info"
          ]
        },
        {
          "name": "system-tasks-richinfo",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_tasks\\.ps1$" },
            "-Action",
            "richinfo"
          ]
        },
        {
          "name": "system-tasks-detail",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_tasks\\.ps1$" },
            "-Action",
            "detail",
            "-Name",
            { "validator": "^(ULTRON|Ultron)[A-Za-z0-9._\\-]{1,80}$" }
          ]
        },
        {
          "name": "system-tasks-run",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_tasks\\.ps1$" },
            "-Action",
            "run",
            "-Name",
            { "validator": "^(ULTRON|Ultron)[A-Za-z0-9._\\-]{1,80}$" }
          ]
        },
        {
          "name": "system-tasks-edit",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_tasks\\.ps1$" },
            "-Action",
            "edit",
            "-Name",
            { "validator": "^(ULTRON|Ultron)[A-Za-z0-9._\\-]{1,80}$" },
            "-NewTriggerType",
            { "validator": "^(Daily|Weekly|AtLogon)$" },
            "-NewTriggerAt",
            { "validator": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
          ]
        },
        {
          "name": "system-tasks-edit-atlogon",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_tasks\\.ps1$" },
            "-Action",
            "edit",
            "-Name",
            { "validator": "^(ULTRON|Ultron)[A-Za-z0-9._\\-]{1,80}$" },
            "-NewTriggerType",
            { "validator": "^AtLogon$" }
          ]
        },
        {
          "name": "system-tasks-delete",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_tasks\\.ps1$" },
            "-Action",
            "delete",
            "-Name",
            { "validator": "^(ULTRON|Ultron)[A-Za-z0-9._\\-]{1,80}$" }
          ]
        },
        {
          "name": "mcp-health",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]mcp_health_check\\.py$" },
            "--quiet"
          ]
        },
        {
          "name": "brain-query",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]brain_index\\.py$" },
            "query",
            { "validator": "^[\\s\\S]{1,500}$" },
            "--limit",
            { "validator": "^[0-9]{1,3}$" }
          ]
        },
        {
          "name": "memory-vault-sync",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]memory_sync\\.py$" },
            "sync"
          ]
        },
        {
          "name": "memory-brain-update",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]brain_index\\.py$" },
            "update"
          ]
        },
        {
          "name": "memory-qdrant-reembed",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]embed_vault\\.py$" },
            "index"
          ]
        },
        {
          "name": "news-generate",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]news_html_generator\\.py$" },
            "--no-open",
            "--model",
            { "validator": "^gemini-[0-9]\\.[0-9]+-(pro|flash|flash-lite)(-preview)?$" }
          ]
        },
        {
          "name": "news-clipboard",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]news_html_generator\\.py$" },
            "--clipboard"
          ]
        },
        {
          "name": "news-clipboard-days",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]news_html_generator\\.py$" },
            "--clipboard",
            "--days",
            { "validator": "^[0-9]{1,2}$" }
          ]
        },
        {
          "name": "news-clipboard-theme",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]news_html_generator\\.py$" },
            "--clipboard",
            "--theme",
            { "validator": "^[^\\r\\n]{1,200}$" }
          ]
        },
        {
          "name": "news-clipboard-full",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]news_html_generator\\.py$" },
            "--clipboard",
            "--days",
            { "validator": "^[0-9]{1,2}$" },
            "--theme",
            { "validator": "^[^\\r\\n]{1,200}$" }
          ]
        },
        {
          "name": "news-generate-days",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]news_html_generator\\.py$" },
            "--no-open",
            "--model",
            { "validator": "^gemini-[0-9]\\.[0-9]+-(pro|flash|flash-lite)(-preview)?$" },
            "--days",
            { "validator": "^[0-9]{1,2}$" }
          ]
        },
        {
          "name": "news-generate-theme",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]news_html_generator\\.py$" },
            "--no-open",
            "--model",
            { "validator": "^gemini-[0-9]\\.[0-9]+-(pro|flash|flash-lite)(-preview)?$" },
            "--theme",
            { "validator": "^[^\\r\\n]{1,200}$" }
          ]
        },
        {
          "name": "news-generate-full",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]news_html_generator\\.py$" },
            "--no-open",
            "--model",
            { "validator": "^gemini-[0-9]\\.[0-9]+-(pro|flash|flash-lite)(-preview)?$" },
            "--days",
            { "validator": "^[0-9]{1,2}$" },
            "--theme",
            { "validator": "^[^\\r\\n]{1,200}$" }
          ]
        },
        {
          "name": "memory-skills-reembed",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]embed_skills\\.py$" }
          ]
        },
        {
          "name": "inline-runner",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]run-inline\\.ps1$" },
            "-Payload",
            { "validator": "^[A-Za-z0-9+/=]{4,100000}$" }
          ]
        },
        {
          "name": "windows-tweaks-status",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]windows-tweaks\\.ps1$" },
            "-Action",
            { "validator": "^status$" }
          ]
        },
        {
          "name": "windows-tweaks-apply",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]windows-tweaks\\.ps1$" },
            "-Action",
            { "validator": "^(apply|revert)$" },
            "-Key",
            { "validator": "^(game-dvr|game-mode|power-plan|focus-assist)$" }
          ]
        },
        {
          "name": "system-diagnose",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]system_diagnose\\.ps1$" },
            "-Hours",
            { "validator": "^[0-9]{1,3}$" }
          ]
        },
        {
          "name": "session-launcher",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]spawn-claude-session\\.ps1$" },
            "-Payload",
            { "validator": "^[A-Za-z0-9+/=]{4,100000}$" }
          ]
        },
        {
          "name": "doctor-check",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^.*[\\/]\\.ultron[\\/]scripts[\\/]cockpit[\\/]doctor_check\\.py$" }
          ]
        }
      ]
    }
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the ULTRON Control Center main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "opener:default",
    "notification:default",
    "notification:allow-notify",
    "dialog:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ultron-status",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\ultron\\.ps1$" },
            "status"
          ]
        },
        {
          "name": "mcp-health",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\mcp_health_check\\.py$" },
            "--quiet"
          ]
        },
        {
          "name": "brain-query",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\brain_index\\.py$" },
            "query",
            { "validator": "^[\\s\\S]{1,500}$" },
            "--limit",
            { "validator": "^[0-9]{1,3}$" }
          ]
        },
        {
          "name": "wt-spawn",
          "cmd": "wt.exe",
          "args": [
            "new-tab",
            "--title",
            { "validator": "^ULTRON · (claude|gemini|codex)$" },
            "--",
            "powershell.exe",
            "-NoExit",
            "-NoProfile",
            "-Command",
            { "validator": "^(Set-Location -LiteralPath '[^\\r\\n]{0,500}'; )?(claude|gemini|codex)( -p)?( '[\\s\\S]{0,8000}')?$" }
          ]
        },
        {
          "name": "gemini-inline",
          "cmd": "uv",
          "args": [
            "run",
            "python",
            { "validator": "^C:\\\\Users\\\\USER\\\\\\.ultron\\\\scripts\\\\cockpit\\\\gemini_cli\\.py$" },
            "--model",
            { "validator": "^[a-zA-Z0-9.\\-]+$" },
            { "validator": "^[\\s\\S]+$" }
          ]
        },
        {
          "name": "claude-inline",
          "cmd": "claude",
          "args": [
            "-p",
            { "validator": "^[\\s\\S]+$" }
          ]
        },
        {
          "name": "claude-inline-model",
          "cmd": "claude",
          "args": [
            "-p",
            { "validator": "^[\\s\\S]+$" },
            "--model",
            { "validator": "^[a-zA-Z0-9.\\-]+$" }
          ]
        },
        {
          "name": "codex-inline",
          "cmd": "codex",
          "args": [
            "exec",
            { "validator": "^[\\s\\S]+$" }
          ]
        },
        {
          "name": "codex-inline-model",
          "cmd": "codex",
          "args": [
            "exec",
            "-m",
            { "validator": "^[a-zA-Z0-9.\\-]+$" },
            { "validator": "^[\\s\\S]+$" }
          ]
        }
      ]
    }
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "detached-project",
  "description": "Capability para ventanas de Project detachadas (label project_*)",
  "windows": [
    "project_*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-open",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "$HOME/.ultron" },
        { "path": "$HOME/.ultron/**" },
        { "path": "$HOME/.ultron-vault" },
        { "path": "$HOME/.ultron-vault/**" },
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$APPDATA/**" },
        { "path": "$LOCALAPPDATA/**" }
      ]
    },
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "$HOME/.ultron" },
        { "path": "$HOME/.ultron/**" },
        { "path": "$HOME/.ultron-vault" },
        { "path": "$HOME/.ultron-vault/**" },
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$APPDATA/**" },
        { "path": "$LOCALAPPDATA/**" }
      ]
    }
  ]
}
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@viz-js/viz": "^3.31.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",

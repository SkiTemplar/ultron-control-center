# ULTRON — environment variable reference
#
# Copy to `.env` (gitignored) if you want shell-style overrides. The Tauri
# backend loads ~/.ultron/.env at startup (preferred location), then
# ~/.ultron/control-center/.env, then cwd/.env, so any key set here is
# available to ai_router.rs without exporting to the shell.
#
# ULTRON authenticates Claude/Gemini/Codex via subscription CLIs by default —
# the API keys below are OPTIONAL and only needed if you want to use the
# AI Router to route specific zones to direct provider APIs.

# ---------------------------------------------------------------------------
# AI Router — direct provider API keys (all optional)
# ---------------------------------------------------------------------------

# Anthropic — used by the `claude-haiku` provider for trivial/light routing.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — used by the `codex` provider when not falling back to codex-cli.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — used by the `gemini` provider when not using gemini-cli.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — fast cheap inference for light loads. https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek — cheap coder model. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=


# ---------------------------------------------------------------------------
# Backup
# ---------------------------------------------------------------------------

# Where weekly-backup.{ps1,sh} writes the mirror. Defaults: D:\BACKUP on
# Windows if the drive exists, otherwise $HOME/BACKUP. Settings UI override
# lives at ~/.ultron/.tmp/backup-root.txt and takes precedence.
ULTRON_BACKUP_ROOT=

# Comma-separated $HOME-relative folders the weekly mirror covers.
# Defaults: .ultron, .ultron-vault, .claude.
# Settings UI checklist at ~/.ultron/cockpit/backup-config.json takes
# precedence (preferred path — see Settings -> Backups -> Sources).
ULTRON_BACKUP_SOURCES=

# ---------------------------------------------------------------------------
# Install verification (Linux)
# ---------------------------------------------------------------------------

# Pin the SHA-256 of the Qdrant binary install.sh downloads. Recommended
# for CI / reproducible installs. Without this, install.sh warns and
# continues; the .sha256 sidecar in the GitHub release is used when
# present.
ULTRON_QDRANT_SHA=

# ---------------------------------------------------------------------------
# Routing (advanced — debugging only)
# ---------------------------------------------------------------------------

# Force the dispatcher into a single rule-match mode for offline testing.
# Leave empty in normal use.
ULTRON_DISPATCHER_TEST_PROMPT=

# ---------------------------------------------------------------------------
# Release tooling (maintainer-only — see docs/MAINTAINERS.md)
# ---------------------------------------------------------------------------

# Classic PAT with `repo` scope. Required by scripts/cut-release.ps1 and
# scripts/delete-orphan-releases.ps1. Never commit this.
GITHUB_TOKEN=
